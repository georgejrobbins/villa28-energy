DATABASE_URL=postgresql://user:password@localhost/villa28energy
POLLING_INTERVAL_SECONDS=300
ENVIRONMENT=production
LOG_LEVEL=INFO
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
DASHBOARD_USERNAME=owner
DASHBOARD_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Device Access console UUID; distinct from the Google Cloud project ID.
GOOGLE_DEVICE_ACCESS_PROJECT_ID=
# Full Google Cloud subscription resource name.
GOOGLE_PUBSUB_SUBSCRIPTION=
# Service account JSON stored as one Railway environment value; never commit a key file.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Railway injects RAILWAY_PUBLIC_DOMAIN. For local development use this override.
PUBLIC_BASE_URL=http://localhost:8000
# International Sungrow OAuth V2. CLIENT_ID is Appkey, CLIENT_SECRET is Secret Key.
SUNGROW_CLIENT_ID=
SUNGROW_CLIENT_SECRET=
SUNGROW_APPLICATION_ID=4161
SUNGROW_API_URL=https://gateway.isolarcloud.com.hk
